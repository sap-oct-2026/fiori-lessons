<mvc:View controllerName="f7lists.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">

        <Label id="label1" text="{/products/1/name}" />

        <List id="productList" headerText="My Products" items="{/products}">
            <!-- <StandardListItem title="{name}" /> -->
            <CustomListItem id="cl1">
                <HBox id="hb1">
                    <VBox id="vb1">
                        <Label id="labelName" text="{name}" />
                        <Label id="labelPrice" text="{price}" />
                    </VBox>
                    <Button id="buttonEdit" text="EDIT" />
                    <Button id="buttonDelete" text="DELETE" />
                </HBox>
            </CustomListItem>
        </List>

        <Button id="button1" press=".onButton1" text="ADD" />
    </Page>
</mvc:View>