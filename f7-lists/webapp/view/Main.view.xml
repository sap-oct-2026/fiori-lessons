<mvc:View controllerName="f7lists.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">

        <Label id="label1" text="{/products/1/name}" />

        <List id="bookList" headerText="My Books" items="{/books}">
            <StandardListItem
                title="{title}"
                description="{author}" />
        </List>

        

    </Page>
</mvc:View>