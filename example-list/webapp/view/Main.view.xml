<mvc:View controllerName="examplelist.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">
        <Table items="{/requests}">
            <columns>
                <Column>
                    <Text text="The title"></Text>
                </Column>
                <Column>
                    <Text text="Urgency"></Text>
                </Column>
            </columns>
            <items>
                <ColumnListItem>
                    <cells>
                        <Text text="{title}"></Text>
                        <Text text="{priority}"></Text>
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
    </Page>
</mvc:View>