<mvc:View controllerName="f2counter.controller.ViewMain"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">
        <VBox id="vbox1">
            <Label id="labelCounter" text="Counter: 0" />
            <HBox id="hbox1">
                <Button id="buttonSubtract" text="-" press=".onSubtract" />
                <Button id="buttonAdd" text="+" press=".onAdd" />
            </HBox>
        </VBox>
    </Page>
</mvc:View>